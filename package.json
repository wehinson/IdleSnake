{
  "name": "idlesnake",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-based idle Snake game.",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check:syntax": "node scripts/check-syntax.js",
    "check:authority": "node scripts/check-authority.js",
    "check": "npm run check:syntax && npm run check:authority && npm test",
    "test:browser": "playwright test",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
